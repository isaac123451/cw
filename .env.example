# PostgreSQL (Supabase). São DUAS conexões, com papéis diferentes:
#
# DATABASE_URL = o que a aplicação usa. No Supabase, o pooler.
#   - Local e servidor fixo: Session pooler, porta 5432
#   - Vercel (serverless):   Transaction pooler, porta 6543
#
# DIRECT_URL = o que `db:push`, `migrate` e `db:seed` usam.
#   Sempre uma conexão de sessão (porta 5432). O pooler em modo
#   transação não sustenta DDL nem os locks da migração.
#
# Ambas ficam em Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres.REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-forte"

# Assistente com IA. Sem esta chave a tela responde em modo local,
# usando consultas prontas sobre os mesmos dados.
# Crie em https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# IA do resumo de conversa — escolha um provedor.
#
# Sem nenhuma chave, o botão "Resumir conversa" da extensão fica
# desligado e diz por quê. Com as duas, a Anthropic ganha; para
# inverter, defina IA_PROVEDOR=gemini.
#
# ATENÇÃO: o que passa por aqui é conversa real de consumidor. Camada
# gratuita costuma permitir que o conteúdo seja usado para treinar o
# modelo; camada paga, não. É decisão de privacidade, não só de custo.
#
# GEMINI_API_KEY=          # aistudio.google.com — só a chave; o número
#                          # do projeto é do Vertex AI, outro endpoint
# GEMINI_MODELO=           # padrão: gemini-flash-latest (apelido que
#                          # não vira 404 quando a família se renova)
# GEMINI_MODELO_RESERVA=   # padrão: gemini-3.6-flash — usado quando o
#                          # apelido responde 503 por congestionamento
# IA_PROVEDOR=             # anthropic | gemini

# Confira com: npm run check:ia

# API de dados (/api/reputacao e /api/casos), consumida por outros
# sistemas da Cardápio Web. Sem esta variável a API fica DESLIGADA —
# nunca aberta. Mínimo de 16 caracteres.
# Gere com: openssl rand -hex 32
API_TOKEN="troque-por-um-token-forte"

# Endereço público da aplicação. Usado para montar a URL de retorno do
# Google. Sem ela, assume http://localhost:3000 (desenvolvimento).
# Em produção: https://seu-dominio.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Agenda. Sem estas duas a integração fica desligada e a tela de
# Agenda mostra o que falta — o resto do sistema não é afetado.
# Passo a passo completo em DEPLOY.md, seção "Google Agenda".
GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# ---------------------------------------------------------------
# Velocidade da IA
#
# Com banco, isto tudo é escolhido na TELA (Configurações →
# Integrações), e o que está aqui só vale como ponto de partida. A
# ordem é banco > ambiente > código: quem escolheu na tela escolheu.
#
# IA_PERFIL: "rapido", "equilibrado" (padrão) ou "profundo".
#   rapido      ~1 s   — modelo pequeno; bom para resumir, raso para decidir
#   equilibrado ~10 s  — maior para decidir, menor para resumir
#   profundo    até 60 s — sem corrida entre modelos
#
# Medido no mesmo minuto, mesmo pedido de 52 tokens, camada gratuita:
#   gemini-flash-latest      estourou 35 s
#   gemini-3.6-flash         10,4 s
#   gemini-flash-lite-latest  0,98 s
#
# O apelido (-latest do flash) concentra a demanda de quem não fixou
# versão, e por isso não é a principal em perfil nenhum — ele é a
# reserva contra o 404, que é o defeito que só ele nunca tem.
# ---------------------------------------------------------------
# IA_PERFIL=equilibrado

# ---------------------------------------------------------------
# Envio de e-mail (codigo da verificacao em duas etapas)
# ---------------------------------------------------------------
# Dois caminhos. Sem nenhum, fora de producao o e-mail sai no
# terminal; em producao o 2FA fica indisponivel de proposito.

# 1) SMTP -- alcanca a equipe inteira, sem mexer em DNS.
#    O servidor da empresa ja esta autorizado a enviar pelo dominio
#    dela. Em conta Google, SMTP_SENHA e uma SENHA DE APP de 16
#    caracteres (myaccount.google.com/apppasswords), nunca a senha
#    de login. O remetente e sempre SMTP_USUARIO: o servidor so
#    deixa enviar em nome da conta autenticada.
SMTP_HOST="smtp.gmail.com"
SMTP_PORTA="587"
SMTP_USUARIO="voce@cardapioweb.com"
SMTP_SENHA="senha-de-app-de-16-caracteres"

# 2) Resend -- POST com JSON, sem dependencia. Exige dominio
#    verificado; sem isso entrega SO para o dono da conta.
RESEND_API_KEY="re_..."

# Qual dos dois usar. Sem esta variavel, o SMTP ganha -- e o motivo
# e que ele e o unico que alcanca todo mundo.
EMAIL_PROVEDOR="smtp"

# Nome de exibicao do remetente. No SMTP o endereco vem de
# SMTP_USUARIO e aqui so o nome e aproveitado.
EMAIL_REMETENTE="CW Reputacao <voce@cardapioweb.com>"
