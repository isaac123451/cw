{
  "manifest_version": 3,
  "name": "CW Reputação — painel de contexto",
  "version": "1.19.0",
  "description": "Mostra o cliente do CW Reputacao ao lado do WhatsApp Web, do Hugme/Reclame Aqui, do ManyChat, do Crisp e do Portal Cardapio Web, poe os textos aprovados ao lado da caixa de mensagem, captura reclamacoes para o Kanban e registra avaliacoes do Google Perfil da Empresa e leva para as Redes os casos da planilha do Google e do canal do Slack.",
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "action": {
    "default_title": "CW Reputação",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png",
      "48": "icones/icone-48.png",
      "128": "icones/icone-128.png"
    }
  },
  "commands": {
    "alternar-painel": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Abrir ou fechar o painel do CW Reputação"
    }
  },
  "background": {
    "service_worker": "fundo/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "opcoes/opcoes.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "cookies",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://www.reclameaqui.com.br/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "conteudo/nucleo.js",
        "conteudo/estilo.js",
        "conteudo/painel-base.js",
        "conteudo/painel-contato.js",
        "conteudo/painel-nps.js",
        "conteudo/painel-caso.js",
        "conteudo/painel-dia.js",
        "conteudo/painel-etapas.js",
        "conteudo/painel-captura.js",
        "conteudo/whatsapp.js",
        "conteudo/respostas.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.hugme.com.br/*",
        "https://*.reclameaqui.com.br/*"
      ],
      "js": [
        "conteudo/nucleo.js",
        "conteudo/estilo.js",
        "conteudo/painel-base.js",
        "conteudo/painel-contato.js",
        "conteudo/painel-nps.js",
        "conteudo/painel-caso.js",
        "conteudo/painel-dia.js",
        "conteudo/painel-etapas.js",
        "conteudo/painel-captura.js",
        "conteudo/ra-campos.js",
        "conteudo/hugme.js",
        "conteudo/ra-resposta.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.manychat.com/*"
      ],
      "js": [
        "conteudo/nucleo.js",
        "conteudo/estilo.js",
        "conteudo/painel-base.js",
        "conteudo/painel-contato.js",
        "conteudo/painel-nps.js",
        "conteudo/painel-caso.js",
        "conteudo/painel-dia.js",
        "conteudo/painel-etapas.js",
        "conteudo/painel-captura.js",
        "conteudo/manychat.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.cardapioweb.com/*"
      ],
      "js": [
        "conteudo/nucleo.js",
        "conteudo/estilo.js",
        "conteudo/painel-base.js",
        "conteudo/painel-contato.js",
        "conteudo/painel-nps.js",
        "conteudo/painel-caso.js",
        "conteudo/painel-dia.js",
        "conteudo/painel-etapas.js",
        "conteudo/painel-captura.js",
        "conteudo/portal-cw.js"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "https://www.cardapioweb.com/*",
        "https://blog.cardapioweb.com/*"
      ]
    },
    {
      "matches": [
        "https://app.crisp.chat/*"
      ],
      "js": [
        "conteudo/nucleo.js",
        "conteudo/estilo.js",
        "conteudo/painel-base.js",
        "conteudo/painel-contato.js",
        "conteudo/painel-nps.js",
        "conteudo/painel-caso.js",
        "conteudo/painel-dia.js",
        "conteudo/painel-etapas.js",
        "conteudo/painel-captura.js",
        "conteudo/crisp.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://business.google.com/*"
      ],
      "js": [
        "conteudo/nucleo.js",
        "conteudo/google-perfil.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://docs.google.com/spreadsheets/*"
      ],
      "js": [
        "conteudo/nucleo.js",
        "conteudo/captura-painel.js",
        "conteudo/planilha.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.slack.com/*"
      ],
      "js": [
        "conteudo/nucleo.js",
        "conteudo/captura-painel.js",
        "conteudo/slack.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fontes/Geist-Variable.woff2"
      ],
      "matches": [
        "https://web.whatsapp.com/*",
        "https://*.hugme.com.br/*",
        "https://*.reclameaqui.com.br/*",
        "https://*.manychat.com/*",
        "https://*.cardapioweb.com/*",
        "https://app.crisp.chat/*",
        "https://docs.google.com/*",
        "https://app.slack.com/*"
      ]
    }
  ]
}
