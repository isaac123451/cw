generator client {
  provider = "prisma-client-js"
}

// Prisma 7: a URL de conexão vive em prisma.config.ts (CLI) e no
// adapter passado ao PrismaClient (runtime).
datasource db {
  provider = "postgresql"
}

/// ============================================================
/// ACESSO
/// ============================================================

enum Role {
  ADMIN
  AGENTE
  LEITURA
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(AGENTE)
  /// Cargo exibido no cadastro de Times ("Analista de Reputação").
  /// Diferente de `role`, que é o nível de acesso.
  jobTitle     String?
  active       Boolean  @default(true)
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedCases   Case[]        @relation("CaseOwner")
  comments     CaseComment[]
  tasks        AgendaTask[]
  savedFilters SavedFilter[]

  @@index([email])
}

/// E-mails liberados para se cadastrar. O domínio @cardapioweb.com é
/// exigido pela aplicação; esta lista controla quem, dentro dele, entra.
model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  note      String?
  createdAt DateTime @default(now())
}

/// ============================================================
/// ESTRUTURA OPERACIONAL
/// ============================================================

model Team {
  id          String  @id @default(cuid())
  name        String  @unique
  legacyName  String?
  description String?
  department  String?
  leader      String?
  active      Boolean @default(true)
  order       Int     @default(0)

  members User[]
  cases   Case[]
}

model WorkflowStatus {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#7C3AED")
  order     Int      @default(0)
  active    Boolean  @default(true)
  wipLimit  Int?
  createdAt DateTime @default(now())
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)

  /// Teto do tempo médio de resposta da categoria, em horas.
  /// Sem teto, a categoria não é cobrada no indicador.
  ceilingHours Int?

  subcategories Subcategory[]
  cases         Case[]
}

model Subcategory {
  id          String  @id @default(cuid())
  name        String
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  cases Case[]

  @@unique([categoryId, name])
}

/// Etiqueta operacional aplicável a um caso — ex.: "favorável a avaliação".
model Tag {
  id          String  @id @default(cuid())
  name        String  @unique
  color       String  @default("#7C3AED")
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)

  cases CaseTag[]
}

model ChecklistItem {
  id       String  @id @default(cuid())
  label    String
  key      String  @unique
  required Boolean @default(false)
  order    Int     @default(0)
  active   Boolean @default(true)

  marks CaseChecklistMark[]
}

/// ============================================================
/// CASOS
/// ============================================================

enum Channel {
  RECLAME_AQUI
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  MANYCHAT
  OUTRO
}

enum Priority {
  CRITICA
  ALTA
  MEDIA
  BAIXA
}

model Company {
  id         String  @id @default(cuid())
  name       String  @unique
  cnpj       String?
  city       String?
  state      String?
  plan       String?
  active     Boolean @default(true)
  externalId String?

  cases Case[]
}

model Case {
  id       String @id @default(cuid())
  protocol String @unique

  channel Channel @default(RECLAME_AQUI)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  /// Preservado da planilha quando a empresa ainda não existe na base.
  companyName String

  customer String
  email    String?
  phone    String?
  city     String?
  state    String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  ownerId String?
  owner   User?   @relation("CaseOwner", fields: [ownerId], references: [id])

  priority Priority @default(MEDIA)
  status   String

  title       String
  description String?

  publicResponse   String?
  publicResponseAt DateTime?

  /// Consumidor avaliou o atendimento no portal.
  evaluated       Boolean   @default(false)
  score           Int?
  resolved        Boolean   @default(false)
  wouldDoBusiness Boolean   @default(false)
  evaluatedAt     DateTime?

  /// Avaliação sinalizada como desconsiderada pelo Reclame Aqui.
  /// É só aviso: a nota continua contando nos indicadores.
  scoreDisregarded Boolean @default(false)

  churnRisk Boolean @default(false)
  request   String?

  responseMinutes Int?
  solutionMinutes Int?
  slaTarget       String?

  externalUrl String?
  externalId  String?

  /// Data de publicação no portal — base de todo cálculo por período.
  publishedAt DateTime
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  tags      CaseTag[]
  comments  CaseComment[]
  events    CaseEvent[]
  marks     CaseChecklistMark[]
  impacts   ImpactRecord[]
  tasks     AgendaTask[]
  movements CaseMovement[]

  @@index([channel, publishedAt])
  @@index([status])
  @@index([companyName])
}

model CaseTag {
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([caseId, tagId])
}

model CaseComment {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  body      String
  createdAt DateTime @default(now())
}

/// Linha do tempo: alimenta a rastreabilidade do caso.
model CaseEvent {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  kind      String
  detail    String?
  actor     String?
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

model CaseChecklistMark {
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  itemId String
  item   ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  done   Boolean   @default(false)
  doneBy String?
  doneAt DateTime?

  @@id([caseId, itemId])
}

/// ============================================================
/// GESTÃO
/// ============================================================

/// Tipo de impacto, administrado pela própria operação.
model ImpactType {
  id          String  @id @default(cuid())
  name        String  @unique
  /// receita soma ao impacto; custo subtrai (valor concedido).
  direction   String  @default("receita")
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)
}

model ImpactRecord {
  id          String   @id @default(cuid())
  type        String
  companyName String
  description String?
  /// Centavos, para não sofrer com ponto flutuante.
  amountCents Int
  owner       String?
  date        DateTime

  /// Vínculos opcionais com os cadastros, quando a origem é conhecida.
  establishmentId String?
  clientSlug      String?

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])
}

model AgendaTask {
  id       String   @id @default(cuid())
  title    String
  type     String
  priority String   @default("Média")
  done     Boolean  @default(false)
  dueDate  DateTime
  time     String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  createdAt DateTime @default(now())
}

/// Filtro salvo pelo usuário (ou pré-definido pela operação).
model SavedFilter {
  id   String @id @default(cuid())
  name String
  /// Critérios serializados — evita uma tabela por tipo de filtro.
  criteria Json
  shared   Boolean @default(false)
  builtIn  Boolean @default(false)
  order    Int     @default(0)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
}

/// Meta definida manualmente para um indicador de reputação.
model ReputationGoal {
  id        String   @id @default(cuid())
  /// resposta | consumidor | solucao | novos-negocios | nota
  indicator String   @unique
  target    Float
  updatedAt DateTime @updatedAt
}

/// ============================================================
/// PRAZOS
/// ============================================================

/// Prazo de resposta e solução por tipo de caso.
model SlaRule {
  id            String  @id @default(cuid())
  /// Nome da categoria; `*` vale como regra padrão.
  category      String
  /// Refina a regra para uma prioridade específica.
  priority      String?
  responseHours Int
  solutionHours Int
  team          String?
  note          String?
  active        Boolean @default(true)

  @@index([category])
}

/// Prazo padrão de retorno por destino de movimentação.
model MovementRule {
  id          String  @id @default(cuid())
  destination String  @unique
  hours       Int
  note        String?
  active      Boolean @default(true)
}

/// Passagem de bastão dentro da tratativa, com relógio próprio.
model CaseMovement {
  id String @id @default(cuid())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  /// Área interna ou o próprio cliente.
  destination String
  reason      String
  actor       String
  startedAt   DateTime
  /// Congelado no encaminhamento: editar a regra não reescreve histórico.
  dueHours    Int
  returnedAt  DateTime?
  outcome     String?

  createdAt DateTime @default(now())

  @@index([caseId, startedAt])
}

/// ============================================================
/// CADASTROS DA OPERAÇÃO
/// ============================================================

/// Restaurante que contrata a Cardápio Web. Não confundir com Cliente.
model Establishment {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  cnpj      String?
  segment   String?
  city      String?
  state     String?
  plan      String
  status    String
  /// Receita mensal recorrente, em centavos.
  mrrCents  Int?
  owner     String?
  startedAt DateTime?
  phone     String?
  email     String?
  notes     String?
}

/// Etapa do ciclo de vida do cliente — colunas do quadro da Jornada.
model JourneyStage {
  id          String  @id @default(cuid())
  name        String  @unique
  color       String  @default("#7C3AED")
  description String  @default("")
  order       Int     @default(0)
  active      Boolean @default(true)
}

/// Agrupador livre da jornada — "Pontos críticos", "Combinados".
model JourneyTopic {
  id    String @id @default(cuid())
  name  String @unique
  icon  String @default("Sparkles")
  color String @default("#7C3AED")
  order Int    @default(0)

  entries JourneyEntry[]
}

/// Registro dentro de um tópico, sempre amarrado a um cliente.
model JourneyEntry {
  id String @id @default(cuid())

  topicId String
  topic   JourneyTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  /// Nome da empresa — o vínculo é por texto, como nas telas.
  company   String
  text      String
  author    String
  createdAt DateTime @default(now())

  @@index([company])
}

/// Iniciativa de melhoria acompanhada pela operação.
model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  stage       String
  owner       String
  impact      String
  progress    Int      @default(0)
  tags        String[] @default([])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

/// Passo a passo operacional documentado.
model Playbook {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  summary       String   @default("")
  scope         String   @default("")
  owner         String
  version       String   @default("1.0")
  /// Passos e regras variam de tamanho; JSON evita uma tabela por lista.
  steps         Json     @default("[]")
  rules         String[] @default([])
  confluenceUrl String?
  updatedAt     DateTime @updatedAt
}

/// Resposta pronta inserida na réplica pública.
model Macro {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String
  owner     String
  tags      String[] @default([])
  uses      Int      @default(0)
  updatedAt DateTime @updatedAt
}
