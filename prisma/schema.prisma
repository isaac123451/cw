generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Case {
  id           String   @id @default(cuid())

  protocol     String?

  company      String

  cnpj         String?

  source       String

  category     String

  subcategory  String?

  priority     String

  status       String

  owner        String?

  description  String?

  createdAt    DateTime @default(now())

  updatedAt    DateTime @updatedAt
}