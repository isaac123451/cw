generator client {
  provider = "prisma-client-js"
}

// Prisma 7: a URL de conexão vive em prisma.config.ts (CLI) e no
// adapter passado ao PrismaClient (runtime).
datasource db {
  provider = "postgresql"
}

/// ============================================================
/// ACESSO
/// ============================================================

enum Role {
  ADMIN
  AGENTE
  LEITURA
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(AGENTE)
  /// Cargo exibido no cadastro de Times ("Analista de Reputação").
  /// Diferente de `role`, que é o nível de acesso.
  jobTitle     String?
  active       Boolean  @default(true)
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedCases   Case[]        @relation("CaseOwner")
  comments     CaseComment[]
  tasks        AgendaTask[]
  savedFilters SavedFilter[]
  googleAccount GoogleAccount?
  preferences   UserPreference?
  npsResponses  NpsResponse[]   @relation("NpsOwner")

  @@index([email])
}

/// Preferências da pessoa: avisos e o recorte "somente minhas".
///
/// Seguem a conta e não o navegador — antes viviam no `localStorage`, e
/// quem configurava no desktop reencontrava tudo no padrão no notebook.
model UserPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Um booleano por tipo de aviso; JSON evita migração a cada aviso novo.
  notifications Json
  somenteMinhas Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// Conta do Google conectada por um usuário, para a agenda.
///
/// Um registro por usuário: cada pessoa conecta a **própria** agenda, e
/// os tokens nunca saem do servidor. Guardados como o Google entrega —
/// mesmo critério do segredo do webhook e do `API_TOKEN`; quem chega ao
/// banco já teria as reclamações inteiras.
model GoogleAccount {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Conta autorizada, exibida na tela para a pessoa conferir qual é.
  email String

  accessToken String
  /// Só vem no primeiro consentimento; por isso nunca sobrescrever com vazio.
  refreshToken String
  /// Quando o access token expira — antes disso não precisa renovar.
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// E-mails liberados para se cadastrar. O domínio @cardapioweb.com é
/// exigido pela aplicação; esta lista controla quem, dentro dele, entra.
model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  note      String?
  createdAt DateTime @default(now())
}

/// ============================================================
/// ESTRUTURA OPERACIONAL
/// ============================================================

model Team {
  id          String  @id @default(cuid())
  name        String  @unique
  legacyName  String?
  description String?
  department  String?
  leader      String?
  active      Boolean @default(true)
  order       Int     @default(0)

  members User[]
  cases   Case[]
}

model WorkflowStatus {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#7C3AED")
  order     Int      @default(0)
  active    Boolean  @default(true)
  wipLimit  Int?
  createdAt DateTime @default(now())
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)

  /// Teto do tempo médio de resposta da categoria, em horas.
  /// Sem teto, a categoria não é cobrada no indicador.
  ceilingHours Int?

  subcategories Subcategory[]
  cases         Case[]
}

model Subcategory {
  id          String  @id @default(cuid())
  name        String
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  cases Case[]

  @@unique([categoryId, name])
}

/// Etiqueta operacional aplicável a um caso — ex.: "favorável a avaliação".
model Tag {
  id          String  @id @default(cuid())
  name        String  @unique
  color       String  @default("#7C3AED")
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)

  cases CaseTag[]
}

model ChecklistItem {
  id       String  @id @default(cuid())
  label    String
  key      String  @unique
  required Boolean @default(false)
  order    Int     @default(0)
  active   Boolean @default(true)

  marks CaseChecklistMark[]
}

/// ============================================================
/// CASOS
/// ============================================================

enum Channel {
  RECLAME_AQUI
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  MANYCHAT
  OUTRO
}

enum Priority {
  CRITICA
  ALTA
  MEDIA
  BAIXA
}

model Company {
  id         String  @id @default(cuid())
  name       String  @unique
  cnpj       String?
  city       String?
  state      String?
  plan       String?
  active     Boolean @default(true)
  externalId String?

  cases Case[]
}

model Case {
  id       String @id @default(cuid())
  protocol String @unique

  channel Channel @default(RECLAME_AQUI)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  /// Preservado da planilha quando a empresa ainda não existe na base.
  companyName String

  customer String
  email    String?
  phone    String?
  city     String?
  state    String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  ownerId String?
  owner   User?   @relation("CaseOwner", fields: [ownerId], references: [id])

  priority Priority @default(MEDIA)
  status   String

  title       String
  description String?

  publicResponse   String?
  publicResponseAt DateTime?

  /// Consumidor avaliou o atendimento no portal.
  evaluated       Boolean   @default(false)
  score           Int?
  resolved        Boolean   @default(false)
  wouldDoBusiness Boolean   @default(false)
  evaluatedAt     DateTime?

  /// Avaliação sinalizada como desconsiderada pelo Reclame Aqui.
  /// É só aviso: a nota continua contando nos indicadores.
  scoreDisregarded Boolean @default(false)

  churnRisk Boolean @default(false)
  request   String?

  responseMinutes Int?
  solutionMinutes Int?
  slaTarget       String?

  externalUrl String?
  externalId  String?

  /// Data de publicação no portal — base de todo cálculo por período.
  publishedAt DateTime
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  tags      CaseTag[]
  comments  CaseComment[]
  events    CaseEvent[]
  marks     CaseChecklistMark[]
  impacts   ImpactRecord[]
  tasks     AgendaTask[]
  movements CaseMovement[]

  @@index([channel, publishedAt])
  @@index([status])
  @@index([companyName])
}

model CaseTag {
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([caseId, tagId])
}

model CaseComment {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  body      String
  createdAt DateTime @default(now())
}

/// Linha do tempo: alimenta a rastreabilidade do caso.
model CaseEvent {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  kind      String
  detail    String?
  actor     String?
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

model CaseChecklistMark {
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  itemId String
  item   ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  done   Boolean   @default(false)
  doneBy String?
  doneAt DateTime?

  @@id([caseId, itemId])
}

/// ============================================================
/// GESTÃO
/// ============================================================

/// Tipo de impacto, administrado pela própria operação.
model ImpactType {
  id          String  @id @default(cuid())
  name        String  @unique
  /// receita soma ao impacto; custo subtrai (valor concedido).
  direction   String  @default("receita")
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)
}

model ImpactRecord {
  id          String   @id @default(cuid())
  type        String
  companyName String
  description String?
  /// Centavos, para não sofrer com ponto flutuante.
  amountCents Int
  owner       String?
  date        DateTime

  /// Vínculos opcionais com os cadastros, quando a origem é conhecida.
  establishmentId String?
  clientSlug      String?

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])
}

model AgendaTask {
  id       String   @id @default(cuid())
  title    String
  type     String
  priority String   @default("Média")
  done     Boolean  @default(false)
  dueDate  DateTime
  time     String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  createdAt DateTime @default(now())
}

/// Filtro salvo pelo usuário (ou pré-definido pela operação).
model SavedFilter {
  id   String @id @default(cuid())
  name String
  /// Critérios serializados — evita uma tabela por tipo de filtro.
  criteria Json
  shared   Boolean @default(false)
  builtIn  Boolean @default(false)
  order    Int     @default(0)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
}

/// Meta definida manualmente para um indicador de reputação.
model ReputationGoal {
  id        String   @id @default(cuid())
  /// resposta | consumidor | solucao | novos-negocios | nota
  indicator String   @unique
  target    Float
  updatedAt DateTime @updatedAt
}

/// ============================================================
/// PRAZOS
/// ============================================================

/// Prazo de resposta e solução por tipo de caso.
model SlaRule {
  id            String  @id @default(cuid())
  /// Nome da categoria; `*` vale como regra padrão.
  category      String
  /// Refina a regra para uma prioridade específica.
  priority      String?
  responseHours Int
  solutionHours Int
  team          String?
  note          String?
  active        Boolean @default(true)

  @@index([category])
}

/// Prazo padrão de retorno por destino de movimentação.
model MovementRule {
  id          String  @id @default(cuid())
  destination String  @unique
  hours       Int
  note        String?
  active      Boolean @default(true)
}

/// Passagem de bastão dentro da tratativa, com relógio próprio.
model CaseMovement {
  id String @id @default(cuid())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  /// Área interna ou o próprio cliente.
  destination String
  reason      String
  actor       String
  startedAt   DateTime
  /// Congelado no encaminhamento: editar a regra não reescreve histórico.
  dueHours    Int
  returnedAt  DateTime?
  outcome     String?

  createdAt DateTime @default(now())

  @@index([caseId, startedAt])
}

/// ============================================================
/// CADASTROS DA OPERAÇÃO
/// ============================================================

/// Restaurante que contrata a Cardápio Web. Não confundir com Cliente.
model Establishment {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  cnpj      String?
  segment   String?
  city      String?
  state     String?
  plan      String
  status    String
  /// Receita mensal recorrente, em centavos.
  mrrCents  Int?
  owner     String?
  startedAt DateTime?
  phone     String?
  email     String?
  notes     String?

  npsResponses NpsResponse[]
}

/// Etapa do ciclo de vida do cliente — colunas do quadro da Jornada.
model JourneyStage {
  id          String  @id @default(cuid())
  name        String  @unique
  color       String  @default("#7C3AED")
  description String  @default("")
  order       Int     @default(0)
  active      Boolean @default(true)

  placements JourneyPlacement[]
}

/// Agrupador livre da jornada — "Pontos críticos", "Combinados".
model JourneyTopic {
  id    String @id @default(cuid())
  name  String @unique
  icon  String @default("Sparkles")
  color String @default("#7C3AED")
  order Int    @default(0)

  entries JourneyEntry[]
}

/// Registro dentro de um tópico, sempre amarrado a um cliente.
model JourneyEntry {
  id String @id @default(cuid())

  topicId String
  topic   JourneyTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  /// Nome da empresa — o vínculo é por texto, como nas telas.
  company   String
  text      String
  author    String
  createdAt DateTime @default(now())

  @@index([company])
}

/// Etapa em que cada cliente está na jornada.
///
/// Tabela própria, e não uma coluna em Company, porque o vínculo aqui é
/// **por nome de empresa** — mesmo critério de `JourneyEntry` — e nem
/// toda empresa que aparece na jornada tem cadastro em Company.
model JourneyPlacement {
  id String @id @default(cuid())

  /// Nome da empresa; um registro por empresa.
  company String @unique

  stageId String
  stage   JourneyStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

/// Iniciativa de melhoria acompanhada pela operação.
model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  stage       String
  owner       String
  impact      String
  progress    Int      @default(0)
  tags        String[] @default([])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

/// Passo a passo operacional documentado.
model Playbook {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  summary       String   @default("")
  scope         String   @default("")
  owner         String
  version       String   @default("1.0")
  /// Passos e regras variam de tamanho; JSON evita uma tabela por lista.
  steps         Json     @default("[]")
  rules         String[] @default([])
  confluenceUrl String?
  updatedAt     DateTime @updatedAt
}

/// Resposta pronta inserida na réplica pública.
model Macro {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String
  owner     String
  tags      String[] @default([])
  uses      Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// ============================================================
/// NPS — ENCERRAMENTO DO CICLO DE FEEDBACK
/// ============================================================

/// Resposta da pesquisa de NPS e a tratativa que fecha o ciclo.
///
/// **Não confundir com Reclame Aqui.** A pesquisa é nossa, dentro do
/// portal, e traz o contato do cliente — é o que permite ligar de volta
/// antes de virar cancelamento ou reclamação pública.
model NpsResponse {
  id String @id @default(cuid())

  /// 0 a 10, como o cliente respondeu.
  score Int
  /// Comentário livre da pesquisa. É daqui que sai a causa raiz.
  comment     String   @default("")
  respondedAt DateTime

  /// Cliente por nome, como no resto da aplicação.
  customer String
  email    String?
  phone    String?

  /// Estabelecimento, quando dá para vincular.
  company         String?
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])

  /// Um dos sete tipos do processo. Nulo enquanto ninguém classificou.
  kind String?

  /// Causa raiz padronizada — serve para ver tendência, não para texto livre.
  rootCause String?

  status String @default("Novo")

  ownerId String?
  owner   User?   @relation("NpsOwner", fields: [ownerId], references: [id])

  /// Prazo do primeiro contato, **congelado** no registro: mudar o SLA
  /// depois não pode reescrever o que já foi prometido.
  firstContactDueAt DateTime
  firstContactAt    DateTime?

  /// Confirmação do cliente de que resolveu — exigida para encerrar
  /// Reclamação e Erro no Sistema como resolvidos.
  confirmedAt DateTime?

  closedAt DateTime?
  /// Rótulo final: "[Encerrado] Resolvido", "[Encerrado] Sem Retorno"...
  outcome String?

  /// Marcações do pós-elogio (review pública, depoimento, indicação).
  reviewAsked      Boolean @default(false)
  testimonialAsked Boolean @default(false)
  referralAsked    Boolean @default(false)

  attempts NpsAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([respondedAt])
  @@index([status])
}

/// Cada tentativa de contato, para sustentar a regra das três em 7 dias.
model NpsAttempt {
  id String @id @default(cuid())

  responseId String
  response   NpsResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  /// e-mail, telefone, whatsapp.
  channel String
  note    String  @default("")
  actor   String

  createdAt DateTime @default(now())

  @@index([responseId, createdAt])
}

/// ============================================================
/// INTEGRAÇÕES
/// ============================================================

/// Webhook para o CW Engine (ou outro destino) ser avisado por evento,
/// em vez de só puxar via GET /api. Um registro só: a aplicação atende
/// um tenant (Cardápio Web), não é multiempresa.
model WebhookConfig {
  id     String  @id @default(cuid())
  url    String
  /// Chave HMAC em texto puro — é segredo compartilhado com quem
  /// recebe, como o `API_TOKEN` do `.env`, não senha de pessoa.
  secret String
  active Boolean @default(true)
  /// Nomes de evento assinados (`caso.criado`, `caso.avaliado`).
  events String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]
}

/// Histórico de tentativas de entrega — o que dá pra diagnosticar direto
/// na tela, sem log de servidor. Só as últimas por webhook: é rastro
/// operacional, não auditoria.
model WebhookDelivery {
  id          String        @id @default(cuid())
  webhookId   String
  webhook     WebhookConfig @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event       String
  caseProtocol String?
  ok          Boolean
  statusCode  Int?
  error       String?
  createdAt   DateTime      @default(now())

  @@index([webhookId, createdAt])
}
