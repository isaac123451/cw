generator client {
  provider = "prisma-client-js"
}

// Prisma 7: a URL de conexão vive em prisma.config.ts (CLI) e no
// adapter passado ao PrismaClient (runtime).
datasource db {
  provider = "postgresql"
}

/// ============================================================
/// ACESSO
/// ============================================================

enum Role {
  ADMIN
  AGENTE
  LEITURA
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(AGENTE)
  /// Cargo exibido no cadastro de Times ("Analista de Reputação").
  /// Diferente de `role`, que é o nível de acesso.
  jobTitle     String?
  active       Boolean  @default(true)
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedCases    Case[]           @relation("CaseOwner")
  comments      CaseComment[]
  tasks         AgendaTask[]
  savedFilters  SavedFilter[]
  googleAccount GoogleAccount?
  preferences   UserPreference?
  npsResponses  NpsResponse[]    @relation("NpsOwner")
  moduleRoles   UserModuleRole[]
  challenges    LoginChallenge[]

  /// Exige código por e-mail no login desta pessoa, mesmo que a
  /// exigência global esteja desligada.
  ///
  /// Separado do global porque as duas perguntas são diferentes: a
  /// empresa pode não exigir de todo mundo e alguém com acesso de
  /// administrador querer para si.
  twoFactorEnabled Boolean @default(false)

  @@index([email])
}

/// Preferências da pessoa: avisos e o recorte "somente minhas".
///
/// Seguem a conta e não o navegador — antes viviam no `localStorage`, e
/// quem configurava no desktop reencontrava tudo no padrão no notebook.
model UserPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Um booleano por tipo de aviso; JSON evita migração a cada aviso novo.
  notifications Json
  somenteMinhas Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// Conta do Google conectada por um usuário, para a agenda.
///
/// Um registro por usuário: cada pessoa conecta a **própria** agenda, e
/// os tokens nunca saem do servidor. Guardados como o Google entrega —
/// mesmo critério do segredo do webhook e do `API_TOKEN`; quem chega ao
/// banco já teria as reclamações inteiras.
model GoogleAccount {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Conta autorizada, exibida na tela para a pessoa conferir qual é.
  email String

  accessToken  String
  /// Só vem no primeiro consentimento; por isso nunca sobrescrever com vazio.
  refreshToken String
  /// Quando o access token expira — antes disso não precisa renovar.
  expiresAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Papel de uma pessoa **dentro de um módulo**.
///
/// Só a exceção é gravada: quem não tem linha aqui segue o `role` da
/// conta. É a mesma escolha das metas de reputação — guardar o padrão
/// em toda linha congelaria uma cópia dele, e mudar o papel da pessoa
/// deixaria de valer onde ninguém mexeu.
///
/// Papel por módulo, e não permissão por ação: são três contas, e o
/// recorte real é "quem mexe no NPS" contra "quem mexe no Reclame
/// Aqui". Permissão por ação exigiria uma decisão a cada action nova, e
/// quem esquecesse criaria um buraco que só aparece quando alguém faz o
/// que não devia.
model UserModuleRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Um dos nomes de `lib/auth/modules.ts`.
  module String
  role   Role

  updatedAt DateTime @updatedAt

  @@unique([userId, module])
}

/// E-mails liberados para se cadastrar. O domínio @cardapioweb.com é
/// exigido pela aplicação; esta lista controla quem, dentro dele, entra.
model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  note      String?
  createdAt DateTime @default(now())
}

/// ============================================================
/// ESTRUTURA OPERACIONAL
/// ============================================================

model Team {
  id          String  @id @default(cuid())
  name        String  @unique
  legacyName  String?
  description String?
  department  String?
  leader      String?
  active      Boolean @default(true)
  order       Int     @default(0)

  members User[]
  cases   Case[]
}

model WorkflowStatus {
  id       String  @id @default(cuid())
  name     String  @unique
  color    String  @default("#7C3AED")
  order    Int     @default(0)
  active   Boolean @default(true)
  wipLimit Int?

  /// Minutos entre lembretes enquanto um caso estiver parado nesta etapa.
  ///
  /// Nulo = etapa silenciosa, que é o padrão. Existe para as etapas de
  /// meio de caminho — "Em atendimento", "Em contato" — onde o caso está
  /// com alguém e some da vista: a extensão cobra de tempos em tempos
  /// até ele sair dali. Etapa final não deve ter lembrete, senão a
  /// cobrança nunca para.
  reminderMinutes Int?

  createdAt DateTime @default(now())
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)

  /// Teto do tempo médio de resposta da categoria, em horas.
  /// Sem teto, a categoria não é cobrada no indicador.
  ceilingHours Int?

  subcategories Subcategory[]
  cases         Case[]
}

model Subcategory {
  id          String  @id @default(cuid())
  name        String
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  cases Case[]

  @@unique([categoryId, name])
}

/// Etiqueta operacional aplicável a um caso — ex.: "favorável a avaliação".
model Tag {
  id          String  @id @default(cuid())
  name        String  @unique
  color       String  @default("#7C3AED")
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)

  cases CaseTag[]
}

model ChecklistItem {
  id       String  @id @default(cuid())
  label    String
  key      String  @unique
  required Boolean @default(false)
  order    Int     @default(0)
  active   Boolean @default(true)

  marks CaseChecklistMark[]
}

/// ============================================================
/// CASOS
/// ============================================================

enum Channel {
  RECLAME_AQUI
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  MANYCHAT
  OUTRO
}

enum Priority {
  CRITICA
  ALTA
  MEDIA
  BAIXA
}

model Company {
  id         String  @id @default(cuid())
  name       String  @unique
  cnpj       String?
  city       String?
  state      String?
  plan       String?
  active     Boolean @default(true)
  externalId String?

  cases Case[]
}

model Case {
  id       String @id @default(cuid())
  protocol String @unique

  channel Channel @default(RECLAME_AQUI)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  /// Preservado da planilha quando a empresa ainda não existe na base.
  companyName String

  customer String
  email    String?
  phone    String?
  city     String?
  state    String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  ownerId String?
  owner   User?   @relation("CaseOwner", fields: [ownerId], references: [id])

  priority Priority @default(MEDIA)
  status   String

  title       String
  description String?

  publicResponse   String?
  publicResponseAt DateTime?

  /// Consumidor avaliou o atendimento no portal.
  evaluated       Boolean   @default(false)
  score           Int?
  resolved        Boolean   @default(false)
  wouldDoBusiness Boolean   @default(false)
  evaluatedAt     DateTime?

  /// Avaliação sinalizada como desconsiderada pelo Reclame Aqui.
  /// É só aviso: a nota continua contando nos indicadores.
  scoreDisregarded Boolean @default(false)

  churnRisk Boolean @default(false)
  request   String?

  /// Documento de cadastro no portal — **CPF ou CNPJ**.
  ///
  /// Vem do **RA Forms**, o formulário que o Reclame Aqui pede antes de
  /// abrir a reclamação. A pergunta lá é literalmente "CPF ou CNPJ", e
  /// a Cardápio Web cadastra estabelecimento das duas formas: 122 das
  /// 127 reclamações da base real respondem com CPF. Um campo chamado
  /// `cnpj` guardando CPF seria uma mentira que custaria uma hora a
  /// quem lesse depois.
  ///
  /// É o único campo que aparece dos dois lados: aqui e no cadastro do
  /// estabelecimento. Por isso ele é o vínculo.
  ///
  /// Guardado só com os dígitos: o portal aceita com e sem pontuação, e
  /// duas grafias do mesmo número nunca casariam entre si.
  document String?

  /// O restaurante por trás da reclamação, quando dá para saber.
  ///
  /// **Não sai do nome.** Medido na base real: nenhum caso tem empresa
  /// diferente do consumidor — o export do Reclame Aqui trata o
  /// reclamante como a empresa. Por isso o WhatsApp mostra o
  /// estabelecimento e a base guarda a pessoa, e os dois não casam.
  ///
  /// O documento casa. É o vínculo que este campo grava.
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])

  /// Alguém decidiu o vínculo na mão — nada automático mexe mais nele.
  ///
  /// Existe porque "sem vínculo" tem dois significados que a coluna
  /// sozinha não distingue: *ainda não foi ligado* e *foi desligado de
  /// propósito*. Sem esta marca, desvincular na tela duraria até a
  /// próxima varredura do cron, que religaria pelo CNPJ — e a pessoa
  /// concluiria, com razão, que o botão de desvincular não funciona.
  ///
  /// Vale nos dois sentidos: vincular à mão também trava, para o
  /// automático não sobrescrever a escolha de alguém que olhou o caso.
  establishmentManual Boolean @default(false)

  responseMinutes Int?
  solutionMinutes Int?
  slaTarget       String?

  externalUrl String?
  externalId  String?

  /// Data de publicação no portal — base de todo cálculo por período.
  publishedAt DateTime
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  tags      CaseTag[]
  comments  CaseComment[]
  events    CaseEvent[]
  marks     CaseChecklistMark[]
  impacts   ImpactRecord[]
  tasks     AgendaTask[]
  movements CaseMovement[]

  @@index([channel, publishedAt])
  @@index([status])
  @@index([companyName])

  /// A extensão busca por documento — igualdade, então índice serve.
  ///
  /// Telefone e e-mail ficam de fora: a busca deles é `contains`, que
  /// varre de qualquer jeito. Índice ali seria custo de escrita sem
  /// ganho de leitura.
  @@index([document])
}

model CaseTag {
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([caseId, tagId])
}

model CaseComment {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  body      String
  createdAt DateTime @default(now())
}

/// Linha do tempo: alimenta a rastreabilidade do caso.
model CaseEvent {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  kind      String
  detail    String?
  actor     String?
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

model CaseChecklistMark {
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  itemId String
  item   ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  done   Boolean   @default(false)
  doneBy String?
  doneAt DateTime?

  @@id([caseId, itemId])
}

/// ============================================================
/// GESTÃO
/// ============================================================

/// Tipo de impacto, administrado pela própria operação.
model ImpactType {
  id          String  @id @default(cuid())
  name        String  @unique
  /// receita soma ao impacto; custo subtrai (valor concedido).
  direction   String  @default("receita")
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)
}

model ImpactRecord {
  id          String   @id @default(cuid())
  type        String
  companyName String
  description String?
  /// Centavos, para não sofrer com ponto flutuante.
  amountCents Int
  owner       String?
  date        DateTime

  /// Vínculos opcionais com os cadastros, quando a origem é conhecida.
  establishmentId String?
  clientSlug      String?

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])
}

model AgendaTask {
  id       String   @id @default(cuid())
  title    String
  type     String
  priority String   @default("Média")
  done     Boolean  @default(false)
  dueDate  DateTime
  time     String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  createdAt DateTime @default(now())
}

/// Filtro salvo pelo usuário (ou pré-definido pela operação).
model SavedFilter {
  id       String  @id @default(cuid())
  name     String
  /// Critérios serializados — evita uma tabela por tipo de filtro.
  criteria Json
  shared   Boolean @default(false)
  builtIn  Boolean @default(false)
  order    Int     @default(0)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
}

/// Meta definida manualmente para um indicador de reputação.
model ReputationGoal {
  id        String   @id @default(cuid())
  /// resposta | consumidor | solucao | novos-negocios | nota
  indicator String   @unique
  target    Float
  updatedAt DateTime @updatedAt
}

/// ============================================================
/// PRAZOS
/// ============================================================

/// Prazo de resposta e solução por tipo de caso.
model SlaRule {
  id            String  @id @default(cuid())
  /// Nome da categoria; `*` vale como regra padrão.
  category      String
  /// Refina a regra para uma prioridade específica.
  priority      String?
  responseHours Int
  solutionHours Int
  team          String?
  note          String?
  active        Boolean @default(true)

  @@index([category])
}

/// Prazo padrão de retorno por destino de movimentação.
model MovementRule {
  id          String  @id @default(cuid())
  destination String  @unique
  hours       Int
  note        String?
  active      Boolean @default(true)
}

/// Passagem de bastão dentro da tratativa, com relógio próprio.
model CaseMovement {
  id String @id @default(cuid())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  /// Área interna ou o próprio cliente.
  destination String
  reason      String
  actor       String
  startedAt   DateTime
  /// Congelado no encaminhamento: editar a regra não reescreve histórico.
  dueHours    Int
  returnedAt  DateTime?
  outcome     String?

  /// Quando o webhook de atraso foi disparado para esta movimentação.
  ///
  /// Atraso é estado que só se descobre comparando com o relógio: não
  /// existe evento no momento em que ele acontece, e por isso quem
  /// avisa é a rotina agendada. O carimbo é o que impede a rotina de
  /// avisar de novo toda madrugada sobre a mesma movimentação parada —
  /// um alerta que se repete sozinho é um alerta que se aprende a
  /// ignorar.
  lateNotifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([caseId, startedAt])
}

/// ============================================================
/// CADASTROS DA OPERAÇÃO
/// ============================================================

/// Restaurante que contrata a Cardápio Web. Não confundir com Cliente.
model Establishment {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// **CPF ou CNPJ.** A Cardápio Web cadastra restaurante das duas
  /// formas — a maioria dos pequenos entra por CPF do proprietário.
  /// Chamar de `cnpj` deixaria metade dos cadastros com o campo errado.
  document String?

  /// Id da conta no CW Engine — a coluna "Company ID" do export.
  ///
  /// É o que liga este cadastro ao sistema onde o restaurante realmente
  /// vive. O documento nem sempre está preenchido lá; este número está.
  externalId String?

  /// Endereço da conta no portal, como o export entrega.
  ///
  /// Guardado inteiro em vez de montado a partir do `externalId`: são
  /// **dois números diferentes** — a conta 27409 abre em /contas/25681 —
  /// e montar a URL a partir do id errado levaria a operação para a
  /// ficha de outro restaurante.
  portalUrl String?

  /// Conversa deste restaurante no Crisp.
  ///
  /// O ManyChat é o canal, mas a conversa fica no Crisp — e quem atende
  /// pelo ManyChat precisa chegar nela. Sem este campo, a extensão só
  /// sabia oferecer WhatsApp, que é outro canal e outra pessoa.
  ///
  /// É link guardado, e não montado a partir de um id: o Crisp usa
  /// identificadores de sessão e de site que não têm relação com o
  /// cadastro daqui — montar levaria a operação para a conversa errada,
  /// que é o mesmo motivo do `portalUrl`.
  crispUrl String?

  /// WhatsApp do contato da pesquisa de NPS.
  ///
  /// Separado do `phone` de propósito. O `phone` é o telefone do
  /// estabelecimento — recepção, fixo, o número do cardápio. Quem
  /// responde o NPS é uma pessoa, com o WhatsApp dela, e ligar para a
  /// loja para falar de uma nota que o dono deu em particular é o tipo
  /// de contato que piora a relação em vez de melhorar.
  npsWhatsapp String?
  segment     String?
  city        String?
  state       String?
  plan        String
  status      String
  /// Receita mensal recorrente, em centavos.
  mrrCents    Int?
  owner       String?
  startedAt   DateTime?
  phone       String?
  email       String?
  notes       String?

  npsResponses NpsResponse[]
  cases        Case[]
}

/// Cliente — a pessoa que reclamou.
///
/// Diferente de `Establishment`, que é o restaurante. A base real nasce
/// das reclamações: cada reclamante vira um cliente **derivado**, e para
/// esse não existe linha aqui. Esta tabela guarda só as duas coisas que
/// o export do Reclame Aqui não traz:
///
/// - o **enriquecimento** de um cliente derivado — tipo de relação,
///   estabelecimento, documento, notas e etiquetas — com `manual` falso;
/// - o cliente **cadastrado à mão**, que não tem reclamação de origem,
///   com `manual` verdadeiro e o contato preenchido.
///
/// Uma tabela e não duas: a chave é a mesma (`slug`) e os campos
/// preenchidos são os mesmos. Separadas, toda carga teria de consultar
/// as duas e costurar o resultado.
model ClientProfile {
  id     String  @id @default(cuid())
  slug   String  @unique
  manual Boolean @default(false)

  /// Só o cadastro manual preenche — o derivado tira da reclamação.
  name  String?
  email String?
  phone String?
  city  String?
  state String?

  /// Consumidor | Proprietário | Operador | Parceiro
  kind            String?
  establishmentId String?
  document        String?
  notes           String?
  tags            String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Etapa do ciclo de vida do cliente — colunas do quadro da Jornada.
model JourneyStage {
  id          String  @id @default(cuid())
  name        String  @unique
  color       String  @default("#7C3AED")
  description String  @default("")
  order       Int     @default(0)
  active      Boolean @default(true)

  placements JourneyPlacement[]
}

/// Agrupador livre da jornada — "Pontos críticos", "Combinados".
model JourneyTopic {
  id    String @id @default(cuid())
  name  String @unique
  icon  String @default("Sparkles")
  color String @default("#7C3AED")
  order Int    @default(0)

  entries JourneyEntry[]
}

/// Registro dentro de um tópico, sempre amarrado a um cliente.
model JourneyEntry {
  id String @id @default(cuid())

  topicId String
  topic   JourneyTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  /// Nome da empresa — o vínculo é por texto, como nas telas.
  company   String
  text      String
  author    String
  createdAt DateTime @default(now())

  @@index([company])
}

/// Etapa em que cada cliente está na jornada.
///
/// Tabela própria, e não uma coluna em Company, porque o vínculo aqui é
/// **por nome de empresa** — mesmo critério de `JourneyEntry` — e nem
/// toda empresa que aparece na jornada tem cadastro em Company.
model JourneyPlacement {
  id String @id @default(cuid())

  /// Nome da empresa; um registro por empresa.
  company String @unique

  stageId String
  stage   JourneyStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

/// Iniciativa de melhoria acompanhada pela operação.
model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  stage       String
  owner       String
  impact      String
  progress    Int      @default(0)
  tags        String[] @default([])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

/// Passo a passo operacional documentado.
model Playbook {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  summary       String   @default("")
  scope         String   @default("")
  owner         String
  version       String   @default("1.0")
  /// Passos e regras variam de tamanho; JSON evita uma tabela por lista.
  steps         Json     @default("[]")
  rules         String[] @default([])
  confluenceUrl String?
  updatedAt     DateTime @updatedAt
}

/// Resposta pronta inserida na réplica pública.
model Macro {
  id       String @id @default(cuid())
  title    String
  body     String
  category String
  owner    String

  /// Onde este texto é usado: "Reclame Aqui" ou "WhatsApp".
  ///
  /// Não é etiqueta: são formatos diferentes. O WhatsApp entende
  /// `*negrito*` e emoji, e a resposta pública do portal mostra os
  /// asteriscos crus. Um texto de WhatsApp oferecido no seletor da
  /// resposta pública seria colado com a marcação à mostra, na frente
  /// do consumidor.
  channel String @default("Reclame Aqui")

  tags      String[] @default([])
  uses      Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Plano ou módulo vendido, com o preço vigente.
///
/// Existe por causa das macros. O texto pronto que explica preço estava
/// com o valor **digitado dentro dele** — e preço digitado em texto
/// envelhece calado: ninguém revisa uma resposta pronta quando a tabela
/// muda, e o consumidor recebe um número que não existe mais.
///
/// Com o cadastro, a macro escreve `{{planos}}` e a tabela é montada na
/// hora da inserção. O valor errado deixa de ser possível por
/// construção.
///
/// **Centavos, e não decimal.** Dinheiro em ponto flutuante soma
/// errado, e o erro só aparece no total de um relatório meses depois.
model Plan {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  /// "plano" ou "modulo" — os dois têm nome, preço e o que incluem.
  kind String @default("plano")

  /// Preço mensal em centavos.
  priceCents Int @default(0)

  /// O que está incluído, uma linha por item.
  features String[] @default([])

  order  Int     @default(0)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// ============================================================
/// NPS — ENCERRAMENTO DO CICLO DE FEEDBACK
/// ============================================================

/// Resposta da pesquisa de NPS e a tratativa que fecha o ciclo.
///
/// **Não confundir com Reclame Aqui.** A pesquisa é nossa, dentro do
/// portal, e traz o contato do cliente — é o que permite ligar de volta
/// antes de virar cancelamento ou reclamação pública.
model NpsResponse {
  id String @id @default(cuid())

  /// 0 a 10, como o cliente respondeu.
  score       Int
  /// Comentário livre da pesquisa. É daqui que sai a causa raiz.
  comment     String   @default("")
  respondedAt DateTime

  /// Cliente por nome, como no resto da aplicação.
  customer String
  email    String?
  phone    String?

  /// Estabelecimento, quando dá para vincular.
  company         String?
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])

  /// Um dos sete tipos do processo. Nulo enquanto ninguém classificou.
  kind String?

  /// Causa raiz padronizada — serve para ver tendência, não para texto livre.
  rootCause String?

  status String @default("Novo")

  ownerId String?
  owner   User?   @relation("NpsOwner", fields: [ownerId], references: [id])

  /// Prazo do primeiro contato, **congelado** no registro: mudar o SLA
  /// depois não pode reescrever o que já foi prometido.
  firstContactDueAt DateTime
  firstContactAt    DateTime?

  /// Confirmação do cliente de que resolveu — exigida para encerrar
  /// Reclamação e Erro no Sistema como resolvidos.
  confirmedAt DateTime?

  closedAt DateTime?
  /// Rótulo final: "[Encerrado] Resolvido", "[Encerrado] Sem Retorno"...
  outcome  String?

  /// Marcações do pós-elogio (review pública, depoimento, indicação).
  reviewAsked      Boolean @default(false)
  testimonialAsked Boolean @default(false)
  referralAsked    Boolean @default(false)

  /// De onde a resposta veio: "Manual" ou "Wootric".
  source String @default("Manual")

  /// Id da resposta no Wootric. É a chave da sincronização: reimportar
  /// a mesma janela atualiza em vez de duplicar. Nulo no registro manual.
  externalId String? @unique

  /// `properties.company_id` do Wootric — o id do estabelecimento no
  /// sistema da própria Cardápio Web. Guardado mesmo sem ter onde casar
  /// ainda: é a chave que vai ligar NPS a estabelecimento no dia em que
  /// o cadastro carregar esse id.
  externalCompanyId String?

  /// ============================================================
  /// PÓS-CONTATO
  ///
  /// A nota do NPS é de **antes**: mede como o cliente estava quando
  /// respondeu a pesquisa, e não pode ser reescrita — é ela que compõe
  /// o indicador. O que faltava era o depois: como a pessoa ficou
  /// depois de falar com a gente, e se a situação foi resolvida.
  /// ============================================================

  /// Régua de humor após o contato, 1 (irritado) a 5 (encantado).
  moodAfter Int?

  /// A situação foi resolvida? Nulo enquanto ninguém registrou.
  resolvedAfter Boolean?

  postContactNote String?
  postContactAt   DateTime?
  postContactBy   String?

  attempts NpsAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([respondedAt])
  @@index([status])
}

/// Causa raiz do NPS, administrada pela própria operação.
///
/// Era uma lista fixa no código (`ROOT_CAUSES`). Virou cadastro porque
/// a operação precisa acrescentar causa nova sem esperar deploy — mas
/// continua sendo **lista fechada**, e não texto livre: causa raiz
/// existe para ver tendência, e "cobrança"/"Cobrança"/"cobranca" num
/// campo aberto viram três problemas diferentes no mesmo gráfico.
model NpsRootCause {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
}

/// Etapa do quadro de NPS, administrada pela própria operação.
///
/// Eram quatro colunas fixas no código (`FLUXO_EM_ANDAMENTO` mais os
/// finais de `ALL_STATUS`). Viraram cadastro pelo mesmo motivo do
/// `WorkflowStatus` do Reclame Aqui: o fluxo da operação muda, e etapa
/// nova não pode depender de deploy.
///
/// **O nome de etapa final começa com `[Encerrado] `, sempre.** Não é
/// convenção de escrita — é o mecanismo: `isEncerrado()` é uma função
/// pura sobre o texto do status, usada em dezenas de lugares que não
/// têm como consultar o banco (o cartão do quadro, o filtro da tela, a
/// fila da extensão, o indicador de resolução). O campo `final` é o que
/// a pessoa marca na tela; a gravação normaliza o nome para carregar o
/// prefixo, e é assim que os dois nunca divergem. Sem isso, uma etapa
/// nova marcada como final não tiraria o ciclo da fila e o indicador
/// passaria a contar como resolvido o que ninguém fechou.
model NpsStage {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  color       String  @default("#7B3FBF")
  order       Int     @default(0)
  active      Boolean @default(true)

  /// Encerra o ciclo: carimba `closedAt` e `outcome`, e tira da fila.
  final Boolean @default(false)

  /// Quais tipos aceitam esta etapa como final. Vazio = todos.
  ///
  /// É o que `KINDS[].finais` fazia no código, do outro lado da
  /// relação: guardar a lista na etapa (e não no tipo) evita que uma
  /// etapa nova nasça inalcançável — quem a cria escolhe ali mesmo
  /// quem pode chegar nela.
  kinds String[] @default([])

  createdAt DateTime @default(now())
}

/// Tipo de tratativa do NPS, administrado pela própria operação.
///
/// Eram os sete do guia, fixos em `KINDS`. Continua sendo **lista
/// fechada**, e não texto livre: o tipo alimenta a análise de tendência,
/// e campo aberto transforma "Reclamação"/"reclamacao" em dois
/// problemas diferentes no mesmo gráfico. O que mudou é quem fecha a
/// lista — a operação, numa tela, em vez de um deploy.
model NpsKind {
  id     String @id @default(cuid())
  name   String @unique
  emoji  String @default("⚪")
  color  String @default("#71717A")
  /// O que fazer, resumido do guia. Aparece na tela de tratativa.
  action String @default("")

  /// Exige o cliente confirmar que resolveu antes de encerrar.
  requiresConfirmation Boolean @default(false)

  /// Exige causa raiz marcada antes de encerrar.
  ///
  /// Era uma lista de três nomes dentro do `checklist()`. Com o tipo
  /// virando cadastro, nome fixo em código volta a ser o defeito que
  /// este cadastro existe para tirar: um tipo novo nasceria sem a
  /// exigência, e a série de causa raiz ganharia um buraco calado.
  requiresRootCause Boolean @default(false)

  /// Abre item de revisão em Projetos e Melhorias ao ser classificado.
  ///
  /// Mesma história: era `if (kind !== "Erro Processual")` no código.
  opensProcessReview Boolean @default(false)

  /// Prazo próprio em horas úteis, quando difere do prazo do segmento.
  ownDeadlineHours Int?

  order  Int     @default(0)
  active Boolean @default(true)

  createdAt DateTime @default(now())
}

/// Cada tentativa de contato, para sustentar a regra das três em 7 dias.
model NpsAttempt {
  id String @id @default(cuid())

  responseId String
  response   NpsResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  /// e-mail, telefone, whatsapp.
  channel String
  note    String @default("")
  actor   String

  createdAt DateTime @default(now())

  @@index([responseId, createdAt])
}

/// ============================================================
/// INTEGRAÇÕES
/// ============================================================

/// Webhook para o CW Engine (ou outro destino) ser avisado por evento,
/// em vez de só puxar via GET /api. Um registro só: a aplicação atende
/// um tenant (Cardápio Web), não é multiempresa.
/// Qual IA responde, e quão rápido — escolhido na tela.
///
/// Antes isso era só variável de ambiente, o que tem dois problemas na
/// prática: mudar exige deploy, e o valor fica invisível para quem usa
/// a ferramenta. "A IA está demorando" é uma reclamação da operação, e
/// a resposta estava num arquivo que a operação não abre.
///
/// Um registro só, como o `WebhookConfig`: a aplicação atende um tenant.
/// Sem registro nenhum, valem as variáveis de ambiente — que continuam
/// sendo o caminho de quem roda isto fora daqui.
model IaConfig {
  /// Id fixo: é singleton, e um `findFirst` sem âncora convida a
  /// existirem dois registros discordando em silêncio.
  id String @id @default("unico")

  /// "auto", "anthropic" ou "gemini".
  provider String @default("auto")

  /// "rapido", "equilibrado" ou "profundo".
  ///
  /// É o que a pessoa realmente quer mexer. Os campos abaixo são a
  /// saída de emergência para quem precisa fixar um modelo específico.
  speed String @default("equilibrado")

  /// Modelo principal fixado à mão. Vazio segue o perfil.
  model         String?
  /// O modelo da via rápida (resumo de conversa).
  modelFast     String?
  /// A rede contra o 404, quando um modelo é aposentado.
  modelFallback String?

  /// Segundos até a reserva partir **em paralelo**. Zero desliga a corrida.
  hedgeSeconds Int?

  /// Segundos até desistir da chamada.
  timeoutSeconds Int?

  updatedAt DateTime @updatedAt
}

model WebhookConfig {
  id     String   @id @default(cuid())
  url    String
  /// Chave HMAC em texto puro — é segredo compartilhado com quem
  /// recebe, como o `API_TOKEN` do `.env`, não senha de pessoa.
  secret String
  active Boolean  @default(true)
  /// Nomes de evento assinados (`caso.criado`, `caso.avaliado`).
  events String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]
}

/// Histórico de tentativas de entrega — o que dá pra diagnosticar direto
/// na tela, sem log de servidor. Só as últimas por webhook: é rastro
/// operacional, não auditoria.
model WebhookDelivery {
  id           String        @id @default(cuid())
  webhookId    String
  webhook      WebhookConfig @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  caseProtocol String?
  ok           Boolean
  statusCode   Int?
  error        String?

  /// O corpo enviado, guardado **só quando a entrega falha**.
  ///
  /// É o que permite reenviar depois: sem ele o reenvio teria de
  /// remontar a mensagem a partir do caso, e o caso já mudou — a
  /// segunda tentativa entregaria um retrato diferente do que a
  /// primeira prometeu.
  ///
  /// Só na falha porque é conteúdo de reclamação: guardar o corpo de
  /// toda entrega bem-sucedida seria uma segunda cópia da base dentro
  /// da tabela de log. Ao reenviar com sucesso, ele é apagado.
  payload Json?

  /// Quantas vezes esta mensagem já foi tentada.
  attempts Int @default(1)

  createdAt DateTime @default(now())

  @@index([webhookId, createdAt])
}

/// ============================================================
/// ACESSO EM DUAS ETAPAS
/// ============================================================

/// Configuração de segurança do acesso. Singleton, como o `IaConfig`.
///
/// Id fixo pelo mesmo motivo: um `findFirst` sem âncora convida a
/// existirem dois registros discordando em silêncio — e aqui os dois
/// discordariam sobre quem entra.
model SecurityConfig {
  id String @id @default("unico")

  /// Exige código por e-mail no login de **todo mundo**.
  ///
  /// Desligado por padrão de propósito: ligar sem provedor de e-mail
  /// configurado trancaria a equipe inteira para fora, e o conserto
  /// exigiria acesso direto ao banco. A tela de configurações só
  /// oferece o botão quando `podeEnviarEmail()` responde que sim.
  twoFactorRequired Boolean @default(false)

  /// Minutos de validade do código.
  ///
  /// Dez é o equilíbrio usual: tempo de abrir o e-mail no celular sem
  /// deixar um código válido esquecido na caixa de entrada a tarde
  /// toda.
  codeTtlMinutes Int @default(10)

  /// Quantos palpites errados antes de o código morrer.
  maxAttempts Int @default(5)

  updatedAt DateTime @updatedAt
  /// Quem mexeu por último — é configuração de acesso, tem de ter dono.
  updatedBy String?
}

/// Um código de verificação em duas etapas: em uso, gasto ou vencido.
///
/// Fica no banco, e não na memória do processo como o freio de
/// tentativas de senha, porque a Vercel roda várias instâncias: um
/// código gerado numa e conferido em outra precisa existir nas duas.
model LoginChallenge {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Hash bcrypt do código, nunca o código.
  ///
  /// Seis dígitos são um milhão de combinações — em claro, um vazamento
  /// do banco viraria vazamento de sessões de quem estivesse entrando
  /// naquele minuto. bcrypt e não HMAC justamente porque o espaço é
  /// pequeno: o custo por tentativa é a defesa.
  codeHash String

  expiresAt  DateTime
  attempts   Int       @default(0)
  /// Carimbo do uso. Código é de uso único; sem isto, um código
  /// interceptado serviria de novo enquanto não vencesse.
  consumedAt DateTime?

  /// De onde veio o pedido — para a auditoria e para o e-mail dizer.
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
